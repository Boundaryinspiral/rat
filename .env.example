BOT_TOKEN=1234567890:replace_with_botfather_token
ADMIN_ID=123456789
API_KEY=replace_with_long_random_secret

# Railway usually provides RAILWAY_PUBLIC_DOMAIN automatically after public networking is enabled.
# Set PUBLIC_URL manually only if the domain is custom or Railway has not exposed it yet.
# PUBLIC_URL=https://your-app.up.railway.app

# Optional hardening/customization.
# WEBHOOK_PATH=/telegram
# WEBHOOK_SECRET=replace_with_long_random_webhook_secret
# ONLINE_TTL_SECONDS=35
# MAX_UPLOAD_MB=50
